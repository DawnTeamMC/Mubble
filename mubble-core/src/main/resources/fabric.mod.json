{
  "schemaVersion": 1,
  "name": "Mubble",
  "id": "mubble",
  "version": "${version}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "fr.hugman.mubble.Mubble"
    ],
    "client": [
      "fr.hugman.mubble.client.MubbleClient"
    ],
    "controlify": [
      "fr.hugman.mubble.client.compat.controlify.MubbleControlifyEntrypoint"
    ]
  },
  "mixins": [
    "mubble.mixins.json",
    {
      "config": "mubble.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "minecraft": "*",
    "fabric-api": "*"
  },
  "suggests": {
    "controlify": "*"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/world/entity/player/Player": [
        "fr/hugman/mubble/world/power_up/PowerUpHolder",
        "fr/hugman/mubble/world/entity/WaterRunner"
      ]
	}
  },
  "license": "LGPL v3.0"
}
